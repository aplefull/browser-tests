{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@data/*": ["./src/assets/data/*"],
      "@mixins": ["./src/app/mixins.scss"],
      "@utils": ["./src/utils/utils.ts"],
      "@math": ["./src/utils/math.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "./src/assets",
    "./public",
    "vite.config.ts",
    "serviceWorker.ts",
    "src/app/pages/js-tests/components/TestWebWorkers/workers/sharedWorker.ts"
  ]
}
