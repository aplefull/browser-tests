{
  "name": "browser-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:stats": "vite build --mode stats",
    "build-projects-cdn": "mkdir -p ./cdn && unzip -o ./src/assets/projects/projects.zip -d ./cdn",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint --error-on-warnings",
    "check": "biome check --write",
    "stylelint": "stylelint ./src/**/*.module.{css,scss}",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "classnames": "^2.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "tabler-icons-react": "^1.56.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-scss": "^7.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
